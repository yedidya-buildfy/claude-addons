{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node $HOME/.claude/usage-by-device/ubd.mjs sync", "async": true }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node $HOME/.claude/usage-by-device/ubd.mjs sync", "async": true }] }
    ]
  }
}
