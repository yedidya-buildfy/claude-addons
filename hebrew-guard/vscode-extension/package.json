{
  "name": "claude-terminal-guard",
  "displayName": "Claude Terminal Guard",
  "description": "One command to reload the window when the terminal's GPU drawing comes out garbled (often after sleep).",
  "version": "1.1.0",
  "publisher": "claude-addons",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeTerminalGuard.reload",
        "title": "Fix garbled terminal drawing (reload window)",
        "category": "Claude"
      }
    ]
  }
}
