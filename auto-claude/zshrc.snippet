# auto-claude: every new terminal opens straight into Claude. Ctrl-C twice
# leaves Claude and drops you at a normal shell prompt.
# It starts as if typed at the first prompt — after VS Code has hooked into the
# terminal — so the pinned message and tab dots work as in a normal session.
# Skipped for: non-interactive shells, `zsh -c`, shells Claude itself spawns,
# VS Code's background environment probe, SSH logins, and nested shells.
# One terminal without it: CLAUDE_AUTOSTART_OFF=1 zsh
# `ccx council` opening a Terminal window asks for one skip with a marker file.
if [[ -o interactive && -e "$HOME/.claude/terminal-state/autostart-skip-once" ]]; then
  rm -f "$HOME/.claude/terminal-state/autostart-skip-once"
  export CLAUDE_AUTOSTART_OFF=1
fi
if [[ -o interactive && -t 0 && -t 1 && -z "$ZSH_EXECUTION_STRING" \
      && -z "$CLAUDECODE" && -z "$CLAUDE_AUTOSTARTED" && -z "$CLAUDE_AUTOSTART_OFF" \
      && -z "$VSCODE_RESOLVING_ENVIRONMENT" && -z "$SSH_CONNECTION" ]]; then
  export CLAUDE_AUTOSTARTED=1
  _auto_claude() {
    add-zle-hook-widget -d line-init _auto_claude
    BUFFER="claude{{skipPermissions}}"
    zle accept-line
  }
  autoload -Uz add-zle-hook-widget && zle -N _auto_claude && add-zle-hook-widget line-init _auto_claude
fi
