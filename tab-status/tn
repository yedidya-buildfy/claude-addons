#!/usr/bin/env python3
"""Set/pin a tab name; --auto respects pins; no name clears the override.

--tty <name> targets that terminal instead of walking up from this process.

Executable from any shell (do not source or run through bash). Walk PPIDs to
find the controlling TTY even when Claude's Bash subprocess has no direct one.
The watcher alone paints the colored status dot.
"""
import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import unicodedata
import uuid


def read(path):
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def atomic_write(path, text):
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=".name-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text + "\n")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def sanitize(text):
    # Keep in sync with tab-autoname.py; these entrypoints install separately.
    text = re.sub(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\|$)", "", text)
    text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)
    text = "".join(" " if c.isspace() else c for c in text
                   if c.isspace() or not unicodedata.category(c).startswith("C"))
    text = " ".join(text.split())
    return text.lstrip("🟢🔴🟡🟠🔵🟣⚫⚪🟤●○◉•·️ ").strip()


def main():
    state = Path.home() / ".claude/terminal-state"
    state.mkdir(parents=True, exist_ok=True)
    args = sys.argv[1:]
    auto, forced_tty = False, ""
    while args and args[0].startswith("--"):
        if args[0] == "--auto":
            auto, args = True, args[1:]
        elif args[0] == "--tty" and len(args) > 1:
            forced_tty, args = args[1], args[2:]
        else:
            print("tn: unknown option " + args[0], file=sys.stderr)
            return 1
    requested = args[0] if args else ""
    name = sanitize(requested)
    if requested and not name:
        print("tn: name contains no visible text", file=sys.stderr)
        return 1

    # --tty names the terminal explicitly: the caller (the editor) is not in its
    # process tree, so the PPID walk below would find the wrong one, or none.
    pid, tty = os.getpid(), forced_tty
    for _ in range(0 if forced_tty else 8):
        try:
            tty = subprocess.check_output(["ps", "-o", "tty=", "-p", str(pid)],
                                          stderr=subprocess.DEVNULL, text=True).strip()
            if tty and tty not in ("??", "?"):
                break
            pid = int(subprocess.check_output(["ps", "-o", "ppid=", "-p", str(pid)],
                                              stderr=subprocess.DEVNULL, text=True).strip())
            tty = ""
        except (OSError, ValueError, subprocess.CalledProcessError):
            tty = ""
            break
    if not tty or not re.fullmatch(r"[A-Za-z0-9_-]+", tty):
        print("tn: no TTY", file=sys.stderr)
        return 1

    mapping = state / ("tty." + tty + ".session")
    session = read(mapping)
    in_session = (bool(re.fullmatch(r"[A-Za-z0-9_-]+", session))
                  and (state / (session + ".state")).exists())
    key = session if in_session else "tty." + tty
    target = state / (key + ".name")
    pin = state / (key + ".pinned")
    # Session-end and the autonamer share this lock. Never remove the lock file.
    with (state / (key + ".name.lock")).open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if in_session and (not (state / (session + ".state")).exists()
                           or read(mapping) != session):
            print("tn: session ended or changed; try again", file=sys.stderr)
            return 1
        if auto and pin.exists():
            print("tn: kept pinned tab name")
            return 0
        # Also invalidate reset-to-the-same-name, which a value check cannot see.
        atomic_write(state / (key + ".name-generation"), uuid.uuid4().hex)
        if not name:
            pin.unlink(missing_ok=True)
            if in_session:
                atomic_write(target, sanitize(Path.cwd().name))
            else:
                target.unlink(missing_ok=True)
            print("tn: cleared pin + override for " + tty)
        else:
            atomic_write(target, name)
            if not auto:
                atomic_write(pin, "")
            print("tn: tab → %r (%s)" % (name, "auto, not pinned" if auto
                                        else "pinned; AI will not rename"))
            if not in_session:
                print("tn: warning — no live Claude session on " + tty
                      + ", so nothing is painting this tab", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except OSError as exc:
        print("tn: " + str(exc), file=sys.stderr)
        sys.exit(1)
