#!/usr/bin/env python3
"""Run Claude Code behind a pseudo-terminal and mark every message you send, so
VS Code's terminal sticky scroll pins it while you scroll through the reply.

Why a wrapper and not a hook: everything else was tried and lost.

  * Writing to the terminal device from a hook does not survive — Claude redraws
    its bottom region every frame and erases whatever an outside process put
    there, leaving the mark stranded on an unrelated row.
  * Printing through Claude (hook `systemMessage`) survives, but Claude strips
    control sequences, so the marks never reach the terminal.

Sitting in the middle solves both: the marks are injected into Claude's own
output, at the exact bytes where it draws the message, so they land on the real
rows and are never redrawn.

What it looks for: Claude draws a submitted message as a background-coloured
block whose first row opens with the `❯` glyph. That combination appears
nowhere else — not even in the input box while you type. The marks go around
the block: prompt-start before its first row, command-start and command-running
at the end of its last row, so exactly the message rows get pinned.

Sticky scroll pins at most `terminal.integrated.stickyScroll.maxLineCount` rows
(default 5, hard max 10) and never more than 40% of the terminal height, so a
long message is shown cut with an ellipsis. That is VS Code's cut, not ours.
"""
import codecs
import fcntl
import os
import pty
import re
import select
import signal
import struct
import sys
import termios
import tty

BEL = b"\a"
OPEN = b"\x1b]633;D;0" + BEL + b"\x1b]633;A" + BEL
CLOSE_B = b"\x1b]633;B" + BEL + b"\x1b]633;C" + BEL

# background colour on, then a foreground colour, then the prompt glyph
BOX_START = re.compile(
    rb"\x1b\[48;[25];[\d;]+m(?=\x1b\[38;[25];[\d;]+m\xe2\x9d\xaf )")
BOX_END = b"\x1b[49m"
# cursor parking that follows the final row of the block
TRAILING_MOVES = re.compile(rb"(?:\r|\x1b\[\d*[ABCD])+$")
# how Claude steps from one row of the block to the next
ROW_BREAK = re.compile(rb"\r(?:\x1b\[\d*[CD])*\x1b\[\d*B")
ANSI = re.compile(rb"\x1b\[[0-9;]*[A-Za-z]|\x1b\][^\a\x1b]*(?:\a|\x1b\\)")

HOLD_LIMIT = 1 << 16   # give up waiting for the end of a block after this much

# Rows to pin. Closing the block after this many rows fixes the pinned window at
# the first N rows of the message, instead of leaving it to VS Code to work out
# from the block's full height.
try:
    ROWS_PINNED = max(1, int(os.environ.get("STICKY_PROMPT_ROWS", "3")))
except ValueError:
    ROWS_PINNED = 3


def command_name(block):
    """The message text, for VS Code's go-to-recent-command list."""
    text = ANSI.sub(b"", block).replace(b"\r", b" ")
    text = b" ".join(text.split())
    text = text.decode("utf-8", "replace").lstrip("❯ ").strip()
    return text.replace("\\", "\\x5c").replace(";", "\\x3b").encode("utf-8")


class Marker:
    """Injects the marks into Claude's output stream."""

    def __init__(self):
        self.held = b""

    def feed(self, chunk):
        data = self.held + chunk
        self.held = b""
        out = []
        pos = 0
        while True:
            start = BOX_START.search(data, pos)
            if not start:
                break
            end = data.find(BOX_END, start.end())
            if end == -1:
                # The block is split across reads. Emit everything before it and
                # keep the rest until the tail arrives.
                out.append(data[pos:start.start()])
                self.held = data[start.start():]
                if len(self.held) > HOLD_LIMIT:
                    out.append(self.held)
                    self.held = b""
                return b"".join(out)
            block = data[start.start():end]
            parked = TRAILING_MOVES.search(block)
            last_row = parked.start() if parked else len(block)
            breaks = [m.start() for m in ROW_BREAK.finditer(block, 0, last_row)]
            # close the block after ROWS_PINNED rows, or at its end if it is shorter
            cut = breaks[ROWS_PINNED - 1] if len(breaks) >= ROWS_PINNED else last_row
            out += [data[pos:start.start()], OPEN, block[:cut], CLOSE_B,
                    b"\x1b]633;E;", command_name(block[:last_row]), BEL, block[cut:]]
            pos = end
        out.append(data[pos:])
        return b"".join(out)

    def drain(self):
        held, self.held = self.held, b""
        return held


# Hebrew letter -> the English key it sits on (standard Hebrew layout).
HEB_TO_KEY = dict(zip("קראטוןםפשדגכעיחלךףזסבהנמצתץ'׳/",
                      "ertyuiopasdfghjkl;zxcvbnm,.wwq"))


def hebrew_command_names():
    """Commands whose own name is Hebrew (e.g. /מועצה) — left in Hebrew."""
    names = set()
    for base in (os.path.expanduser("~/.claude"), os.path.join(os.getcwd(), ".claude")):
        for sub in ("skills", "commands"):
            try:
                entries = os.listdir(os.path.join(base, sub))
            except OSError:
                continue
            for name in entries:
                name = name[:-3] if name.endswith(".md") else name
                if any("א" <= c <= "ת" for c in name):
                    names.add(name)
    return names


class SlashFix:
    """Typing a slash command while the keyboard is still on Hebrew: `/בךקשר`
    reaches Claude as `/clear`, live, so its command menu matches as you type.

    Only the first word of a message that starts with `/` is touched (or with
    `.`, which the Hebrew layout puts on the slash key). The input box itself is
    Claude's, so its state is tracked from the keys alone; after an arrow key
    the tracking stops guessing until the next Enter.
    """

    def __init__(self, hebrew_names=()):
        self.names = tuple(hebrew_names)
        self.decoder = codecs.getincrementaldecoder("utf-8")("surrogateescape")
        self.typed = 0      # characters in the input box, as far as we know
        self.word = None    # original chars after the leading slash, or None
        self.lead = "/"
        self.raw = False    # current word sent as typed (a Hebrew command name)

    def feed(self, data):
        text = self.decoder.decode(data)
        if "\x1b" in text:
            if text in ("\x1b[A", "\x1b[B", "\x1bOA", "\x1bOB"):
                if self.word is None:           # history recall fills the box
                    self.typed = self.typed or 1
                return data                     # else: moving in the command menu
            self.word = None
            if "\x1b[200~" in text or "\r" in text:   # paste, Alt+Enter
                self.typed += 1
            return text.encode("utf-8", "surrogateescape")  # Esc, Shift+Tab: box unchanged
        return "".join(map(self.key, text)).encode("utf-8", "surrogateescape")

    def key(self, ch):
        if ch in "\r\n\x03\x15":            # Enter, Ctrl-C, Ctrl-U: box is empty
            self.typed, self.word = 0, None
            return ch
        if ch in "\x7f\x08":
            if self.word:
                self.word = self.word[:-1]
                self.raw = self.is_name(self.word)
            elif self.word is not None:
                self.word = None
            self.typed = max(0, self.typed - 1)
            return ch
        self.typed += 1
        if self.word is None:
            if self.typed == 1 and ch in "/.":
                self.word, self.lead, self.raw = "", ch, False
            return ch
        if ch not in HEB_TO_KEY:
            # `-`, `_`, digits are the same on both layouts; anything else
            # (a space, an English letter, a path) means leave the rest alone
            if self.lead == "/" and ch in "-_0123456789":
                self.word += ch
            else:
                self.word = None
            return ch
        word = self.word + ch
        fix = ""
        if self.lead == "." and not self.word:
            fix, self.lead = "\x7f/", "/"   # `.` was the slash key on Hebrew
        if self.lead == "/" and self.is_name(word):
            self.word, self.raw = word, True
            return fix + ch
        out = fix + ("\x7f" * len(self.word) + convert(word) if self.raw else convert(ch))
        self.word, self.raw = word, False
        return out

    def is_name(self, word):
        return bool(word) and any(n.startswith(word) for n in self.names)


def convert(text):
    return "".join(HEB_TO_KEY.get(c, c) for c in text)


# A key with Ctrl, Alt or Cmd held, as the terminal reports it once Claude turns
# on detailed key reporting: `ESC [ code ; mods u` or `ESC [ 27 ; mods ; code ~`.
# On the Hebrew layout the code is the Hebrew letter, so Ctrl-C arrives as
# Ctrl-ב and Claude ignores it. Swap in the English key on the same spot.
CSI_U = re.compile(rb"\x1b\[(\d+)((?::\d*)*);(\d+)((?::\d+)?(?:;[\d:]*)?)u")
CSI_27 = re.compile(rb"\x1b\[27;(\d+);(\d+)~")
HEB_CODE = {ord(h): ord(e) for h, e in HEB_TO_KEY.items() if "א" <= h <= "ת"}


def english_code(code, mods):
    """The English key's code when a modifier other than Shift is held."""
    code = int(code)
    if code in HEB_CODE and (int(mods) - 1) & 0b1110:
        return b"%d" % HEB_CODE[code]
    return None


def english_shortcuts(data):
    # ponytail: a sequence split across two reads passes through unchanged
    def u(m):
        new = english_code(m[1], m[3])
        return m[0] if new is None else b"\x1b[" + new + m[2] + b";" + m[3] + m[4] + b"u"

    def k27(m):
        new = english_code(m[2], m[1])
        return m[0] if new is None else b"\x1b[27;" + m[1] + b";" + new + b"~"

    return CSI_27.sub(k27, CSI_U.sub(u, data))


def write_all(fd, data):
    while data:
        try:
            data = data[os.write(fd, data):]
        except BlockingIOError:
            select.select([], [fd], [])


def main():
    argv = ["claude"] + sys.argv[1:]
    real = os.environ.get("STICKY_CLAUDE_BIN") or "claude"
    argv[0] = real

    # Nothing to mark when the output is not a terminal — get out of the way.
    if not sys.stdout.isatty() or not sys.stdin.isatty():
        os.execvp(real, argv)

    pid, fd = pty.fork()
    if pid == 0:
        os.execvp(real, argv)
        os._exit(127)

    def sync_size(*_):
        try:
            size = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(fd, termios.TIOCSWINSZ, size)
        except OSError:
            pass

    sync_size()
    signal.signal(signal.SIGWINCH, sync_size)

    stdin_fd = sys.stdin.fileno()
    saved = termios.tcgetattr(stdin_fd)
    marker = Marker()
    slash = None if os.environ.get("STICKY_HEBREW_SLASH") == "0" else SlashFix(hebrew_command_names())
    try:
        tty.setraw(stdin_fd)
        while True:
            try:
                readable, _, _ = select.select([stdin_fd, fd], [], [], 0.05)
            except InterruptedError:
                continue
            if not readable and marker.held:
                write_all(sys.stdout.fileno(), marker.drain())
            if stdin_fd in readable:
                data = os.read(stdin_fd, 65536)
                if data:
                    data = english_shortcuts(data)
                    write_all(fd, slash.feed(data) if slash else data)
            if fd in readable:
                try:
                    data = os.read(fd, 65536)
                except OSError:
                    break
                if not data:
                    break
                write_all(sys.stdout.fileno(), marker.feed(data))
    finally:
        termios.tcsetattr(stdin_fd, termios.TCSAFLUSH, saved)
        leftover = marker.drain()
        if leftover:
            write_all(sys.stdout.fileno(), leftover)

    _, status = os.waitpid(pid, 0)
    sys.exit(os.waitstatus_to_exitcode(status))


if __name__ == "__main__":
    if "--filter" in sys.argv[1:2]:
        # Transform a recorded stream on stdin — used by selftest.sh.
        sys.stdout.buffer.write(Marker().feed(sys.stdin.buffer.read()))
    else:
        main()
